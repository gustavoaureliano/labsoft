# Endereço da API FastAPI usado pelo Next.js para encaminhar /api/.
BACKEND_URL=http://127.0.0.1:8000
IDENTITY_URL=http://127.0.0.1:18101
# Ative somente com identidade real configurada nos dois backends.
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_EMAIL_FLOWS_ENABLED=false

# Para acessar o Next.js em desenvolvimento por outro computador da rede,
# descomente a linha abaixo e substitua pelo IP local da máquina que executa
# o frontend (sem protocolo ou porta).
# DEV_ORIGIN=192.168.1.100
